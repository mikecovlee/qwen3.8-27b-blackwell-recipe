# Copy to `.env` and adjust. The compose files read these values.
# scripts/online/setup.sh generates this file for you.

# --- Inference (SGLang) ---
# Host directory that contains the model folder (mounted read-only at /models).
MODELS_DIR=/home/you/models
# Model folder name inside MODELS_DIR.
MODEL_DIR=Qwen3.8-27B-RadixArk-NVFP4
# Served model name exposed by the OpenAI-compatible API.
MODEL_NAME=qwen3.8-27b
SGLANG_PORT=8080
# Inference image. Leave unset: each profile pins the right default —
#   fp8v (mainline):   llm-infer:latchfix-d6e72886, the patched derived image the
#                      setup scripts build from the pinned v0.5.19-line base;
#   nvfp4 / fp8 (legacy): lmsysorg/sglang@sha256:b91d664a... (old pinned tree).
# The setup scripts normalize this line per VARIANT; only override manually if you
# know exactly why.
# SGLANG_IMAGE=llm-infer:latchfix-d6e72886
# GPU_COUNT=all
# TZ=Asia/Shanghai

# --- Gateway (New API) ---
# REQUIRED. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-random-32-byte-hex
GATEWAY_PORT=8088
# NEWAPI_IMAGE=calciumion/new-api:v1.0.0-rc.36
