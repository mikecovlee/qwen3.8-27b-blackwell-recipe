# Copy to `.env` and adjust. The compose files read these values.
# scripts/online/setup.sh generates this file for you.

# --- Inference (SGLang) ---
# Host directory that contains the model folder (mounted read-only at /models).
MODELS_DIR=/home/you/models
# Model folder name inside MODELS_DIR.
MODEL_DIR=Qwen3.8-27B-NVFP4
# Served model name exposed by the OpenAI-compatible API.
MODEL_NAME=qwen3.8-27b
SGLANG_PORT=8080
# Inference image. Each profile pins its own default and the compose files
# hardcode it, so SGLANG_IMAGE is no longer read (written by setup.sh for
# bookkeeping only):
#   fp8v / fp8:       llm-infer:hicache-f832b5c3 — v0.5.23 tree with the
#                     HiCache-mamba patches baked in (sched-latch retired
#                     upstream, #44401);
#   fp8vmtp (spec):   llm-infer:spec-f832b5c3 — the derived image plus
#                     draft-share;
#   nvfp4:            llm-infer:nvfp4-f832b5c3 — the derived image plus the
#                     NVFP4 host-transport patch set.
# GPU_COUNT=all
# TZ=Asia/Shanghai

# --- Gateway (New API) ---
# REQUIRED. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-random-32-byte-hex
GATEWAY_PORT=8088
# NEWAPI_IMAGE=calciumion/new-api:v1.0.0-rc.40
