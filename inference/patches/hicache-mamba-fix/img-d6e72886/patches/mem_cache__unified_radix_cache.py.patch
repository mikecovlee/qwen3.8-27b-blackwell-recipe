         insert_params.value = values
         result = self.insert(insert_params)
 
+        # Write-through backup for chunked prefills (backport of upstream
+        # PR #36647): chunked inserts bypass the hit-count backup path, so
+        # explicitly back up the newly inserted chain here.
+        if chunked and result is not None and result.last_device_node is not None:
+            tree = self.tree_core
+            if tree.enable_hicache and not tree.is_write_back:
+                node = tree.node_by_id(result.last_device_node)
+                if not node.backuped:
+                    self._apply_cache_actions([tree._build_backup_kv_action(node)])
