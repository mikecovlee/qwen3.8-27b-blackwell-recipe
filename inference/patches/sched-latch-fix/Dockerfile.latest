# Derived image that bakes the sched-latch false-latch patch into
# lmsysorg/sglang:latest pinned at index digest
# sha256:d6e7288627be8b02be88e4bba38e73f6d50e2826869f753c13a4c4385ab3eda9
# (source tree 0bcd822, v0.5.19 line, built 2026-09-04).
#
# Why a derived image instead of the PYTHONPATH mount used for the b91d664a build:
# this base (Ubuntu python3.12) ships /usr/lib/python3.12/sitecustomize.py, which
# satisfies the startup `import sitecustomize` before /patches is ever searched —
# a mounted patch module would never load. site-packages .pth files, on the other
# hand, are executed during interpreter startup regardless of the system file.
#
# Build:  docker build -f Dockerfile.latest -t sglang-latchfix:latest .
#         (run from this directory; the image stays local unless you push it)
FROM lmsysorg/sglang@sha256:d6e7288627be8b02be88e4bba38e73f6d50e2826869f753c13a4c4385ab3eda9

COPY img-d6e72886/sched_latch_fix.py /opt/sglang/lib/python3.12/site-packages/sched_latch_fix.py
RUN echo 'import sched_latch_fix' > /opt/sglang/lib/python3.12/site-packages/99-sched-latch-fix.pth
